{
  "moduleFileExtensions": ["ts", "js", "json"],
  "rootDir": "..",
  "testRegex": "test/e2e/.*\\.e2e-spec\\.ts$",
  "moduleNameMapper": { "^@/(.*)$": "<rootDir>/$1" },
  "transform": { "^.+\\.ts$": "ts-jest" },
  "testEnvironment": "node",
  "setupFiles": ["<rootDir>/test/setup-env.ts"],
  "testTimeout": 60000
}
