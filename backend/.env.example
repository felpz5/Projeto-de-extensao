# Ambiente: development | test | production
NODE_ENV=development
PORT=3333

# Banco (Supabase/Neon). DATABASE_URL = usuário da API (gestock_app, sem BYPASSRLS).
# DIRECT_URL = usuário dono das tabelas, usado só pelas migrations. Em dev podem ser iguais.
# Supabase com pooler (porta 6543): acrescente ?pgbouncer=true na DATABASE_URL.
# Com o banco do Docker (docker compose up -d db migrate): use as senhas do .env da raiz
# (APP_DB_PASSWORD na DATABASE_URL, POSTGRES_PASSWORD na DIRECT_URL).
DATABASE_URL=postgresql://gestock_app:senha@localhost:5432/gestock
DIRECT_URL=postgresql://postgres:senha@localhost:5432/gestock

# Gere com: node -e "console.log(require('crypto').randomBytes(48).toString('base64url'))"
JWT_ACCESS_SECRET=troque-por-um-segredo-longo-e-aleatorio
JWT_ACCESS_TTL=15m
REFRESH_TOKEN_TTL_DAYS=7

# Front-end autorizado (separe vários por vírgula)
CORS_ORIGIN=http://localhost:5173
# strict (front e API no mesmo site, ex.: app.gestock.com e api.gestock.com)
# none (front e API em sites diferentes, ex.: vercel.app + onrender.com; exige HTTPS)
COOKIE_SAMESITE=strict

# Quantos proxies ficam na frente da API (Render/Railway = 1). 0 = acesso direto.
# Necessário para o limite de requisições enxergar o IP real do cliente.
TRUST_PROXY=0
