// Gestock — modelo de dados (MVP)
// Convenções:
// - Toda tabela operacional tem tenant_id e é protegida por Row Level Security (ver migration rls).
// - Quantidades em numeric(14,3) na unidade base do ingrediente (g, ml ou un).
// - Dinheiro em numeric(12,2).

generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider  = "postgresql"
  url       = env("DATABASE_URL") // usuário da aplicação (sem BYPASSRLS)
  directUrl = env("DIRECT_URL") // usuário dono das tabelas (migrations)
}

// ---------- Enums ----------

enum Role {
  OWNER
  MANAGER
  STAFF
}

enum MembershipStatus {
  ACTIVE
  DISABLED
  INVITED // convidado por um dono; só vale depois que a pessoa aceita
}

enum CategoryKind {
  PRODUCT
  INGREDIENT
}

enum BaseUnit {
  G
  ML
  UN
}

enum PricingMode {
  UNIT // preço fixo por unidade
  WEIGHT // preço por kg (ex.: açaí no peso)
}

enum MovementType {
  INITIAL
  PURCHASE
  SALE_CONSUMPTION
  MANUAL_OUT
  LOSS
  ADJUSTMENT
}

/// Forma de pagamento da venda (fechamento de caixa).
enum PaymentMethod {
  CASH // dinheiro
  PIX
  CREDIT_CARD
  DEBIT_CARD
  VOUCHER // vale-refeição/alimentação
  OTHER
}

/// Venda nunca é apagada: erro de lançamento vira cancelamento (com motivo e estorno do estoque).
enum SaleStatus {
  COMPLETED
  CANCELED
}

/// De onde veio a venda: registrada no sistema ou importada do histórico (caderno/planilha).
/// Venda importada NÃO baixa estoque: é só histórico para relatórios e previsão.
enum SaleSource {
  APP
  IMPORT
}

enum SaleChannel {
  IN_STORE
  ONLINE
}

enum QuantitySource {
  MEASURED // pesado/informado de verdade
  RECIPE // veio da receita fixa do produto
  STANDARD_PORTION // selecionado + porção padrão (estimativa)
  UNKNOWN // sabemos que foi usado, não sabemos quanto
}

enum RevokeReason {
  ROTATED // trocado por um novo no refresh (normal)
  LOGOUT // sessão encerrada pelo usuário ou troca de estabelecimento
  REUSE_DETECTED // token antigo reapresentado: todas as sessões derrubadas
  PASSWORD_CHANGED // senha trocada: outras sessões encerradas
}

// ---------- Contas (globais, sem RLS) ----------

model User {
  id                 String    @id @default(uuid()) @db.Uuid
  name               String
  email              String    @unique
  passwordHash       String    @map("password_hash")
  failedLoginCount   Int       @default(0) @map("failed_login_count")
  lockedUntil        DateTime? @map("locked_until")
  /// Senha provisória (criada por um dono): o front deve exigir a troca no primeiro acesso.
  mustChangePassword Boolean   @default(false) @map("must_change_password")
  createdAt          DateTime  @default(now()) @map("created_at")
  updatedAt          DateTime  @updatedAt @map("updated_at")

  memberships   Membership[]
  refreshTokens RefreshToken[]

  @@map("users")
}

model RefreshToken {
  id            String        @id @default(uuid()) @db.Uuid
  userId        String        @map("user_id") @db.Uuid
  tenantId      String?       @map("tenant_id") @db.Uuid
  tokenHash     String        @unique @map("token_hash")
  expiresAt     DateTime      @map("expires_at")
  revokedAt     DateTime?     @map("revoked_at")
  /// Só tokens ROTATED têm a tolerância de corrida entre abas no refresh.
  revokedReason RevokeReason? @map("revoked_reason")
  createdAt     DateTime      @default(now()) @map("created_at")

  user User @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@index([userId])
  @@map("refresh_tokens")
}

// ---------- Estabelecimentos ----------

model Tenant {
  id        String   @id @default(uuid()) @db.Uuid
  name      String
  slug      String   @unique
  segment   String?
  timezone  String   @default("America/Sao_Paulo")
  /// Loja de demonstração (seed): dados SIMULADOS, nunca usar como resultado do parceiro.
  isDemo    Boolean  @default(false) @map("is_demo")
  createdAt DateTime @default(now()) @map("created_at")
  updatedAt DateTime @updatedAt @map("updated_at")

  memberships    Membership[]
  categories     Category[]
  ingredients    Ingredient[]
  products       Product[]
  recipeItems    RecipeItem[]
  weightMixItems WeightMixItem[]
  movements      StockMovement[]
  sales          Sale[]
  saleItems      SaleItem[]
  saleItemIngr   SaleItemIngredient[]
  auditLogs      AuditLog[]
  balances       IngredientBalance[]
  saleImports    SaleImport[]

  @@map("tenants")
}

model Membership {
  id        String           @id @default(uuid()) @db.Uuid
  tenantId  String           @map("tenant_id") @db.Uuid
  userId    String           @map("user_id") @db.Uuid
  role      Role
  status    MembershipStatus @default(ACTIVE)
  createdAt DateTime         @default(now()) @map("created_at")

  tenant Tenant @relation(fields: [tenantId], references: [id], onDelete: Cascade)
  user   User   @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@unique([tenantId, userId])
  @@index([userId])
  @@map("memberships")
}

// ---------- Catálogo ----------

model Category {
  id        String       @id @default(uuid()) @db.Uuid
  tenantId  String       @map("tenant_id") @db.Uuid
  name      String
  kind      CategoryKind
  createdAt DateTime     @default(now()) @map("created_at")

  tenant      Tenant       @relation(fields: [tenantId], references: [id], onDelete: Cascade)
  ingredients Ingredient[]
  products    Product[]

  @@unique([tenantId, kind, name])
  @@map("categories")
}

model Ingredient {
  id             String   @id @default(uuid()) @db.Uuid
  tenantId       String   @map("tenant_id") @db.Uuid
  categoryId     String?  @map("category_id") @db.Uuid
  name           String
  baseUnit       BaseUnit @map("base_unit")
  minStock       Decimal  @default(0) @map("min_stock") @db.Decimal(14, 3)
  costPerUnit    Decimal? @map("cost_per_unit") @db.Decimal(12, 4)
  leadTimeDays   Int      @default(1) @map("lead_time_days")
  defaultPortion Decimal? @map("default_portion") @db.Decimal(14, 3)
  active         Boolean  @default(true)
  createdAt      DateTime @default(now()) @map("created_at")
  updatedAt      DateTime @updatedAt @map("updated_at")

  tenant          Tenant               @relation(fields: [tenantId], references: [id], onDelete: Cascade)
  category        Category?            @relation(fields: [categoryId], references: [id], onDelete: SetNull)
  recipeItems     RecipeItem[]
  weightMixItems  WeightMixItem[]
  movements       StockMovement[]
  saleIngredients SaleItemIngredient[]
  balance         IngredientBalance?

  @@unique([tenantId, name])
  @@map("ingredients")
}

model Product {
  id          String      @id @default(uuid()) @db.Uuid
  tenantId    String      @map("tenant_id") @db.Uuid
  categoryId  String?     @map("category_id") @db.Uuid
  name        String
  pricingMode PricingMode @map("pricing_mode")
  price       Decimal     @db.Decimal(12, 2) // UNIT: preço unitário · WEIGHT: preço por kg
  active      Boolean     @default(true)
  createdAt   DateTime    @default(now()) @map("created_at")
  updatedAt   DateTime    @updatedAt @map("updated_at")

  tenant      Tenant          @relation(fields: [tenantId], references: [id], onDelete: Cascade)
  category    Category?       @relation(fields: [categoryId], references: [id], onDelete: SetNull)
  recipeItems RecipeItem[]
  weightMix   WeightMixItem[]
  saleItems   SaleItem[]

  @@unique([tenantId, name])
  @@map("products")
}

/// Receita fixa: quantidade de ingrediente por 1 unidade do produto (só produtos UNIT).
model RecipeItem {
  id           String  @id @default(uuid()) @db.Uuid
  tenantId     String  @map("tenant_id") @db.Uuid
  productId    String  @map("product_id") @db.Uuid
  ingredientId String  @map("ingredient_id") @db.Uuid
  quantity     Decimal @db.Decimal(14, 3)

  tenant     Tenant     @relation(fields: [tenantId], references: [id], onDelete: Cascade)
  product    Product    @relation(fields: [productId], references: [id], onDelete: Cascade)
  ingredient Ingredient @relation(fields: [ingredientId], references: [id], onDelete: Restrict)

  @@unique([productId, ingredientId])
  @@map("recipe_items")
}

/// Composição média de produtos vendidos por peso. Usada APENAS para estimativas.
model WeightMixItem {
  id           String  @id @default(uuid()) @db.Uuid
  tenantId     String  @map("tenant_id") @db.Uuid
  productId    String  @map("product_id") @db.Uuid
  ingredientId String  @map("ingredient_id") @db.Uuid
  percentage   Decimal @db.Decimal(5, 2)

  tenant     Tenant     @relation(fields: [tenantId], references: [id], onDelete: Cascade)
  product    Product    @relation(fields: [productId], references: [id], onDelete: Cascade)
  ingredient Ingredient @relation(fields: [ingredientId], references: [id], onDelete: Restrict)

  @@unique([productId, ingredientId])
  @@map("weight_mix_items")
}

// ---------- Estoque (livro-razão) ----------

/// Saldo atual de cada ingrediente, mantido pelo próprio banco (trigger em stock_movements).
/// Evita somar o histórico inteiro a cada consulta: o saldo é lido direto, não importa
/// quantos anos de movimentações existam. Nunca grave aqui pelo código.
model IngredientBalance {
  ingredientId String   @id @map("ingredient_id") @db.Uuid
  tenantId     String   @map("tenant_id") @db.Uuid
  quantity     Decimal  @default(0) @db.Decimal(16, 3)
  updatedAt    DateTime @default(now()) @map("updated_at")

  tenant     Tenant     @relation(fields: [tenantId], references: [id], onDelete: Cascade)
  ingredient Ingredient @relation(fields: [ingredientId], references: [id], onDelete: Cascade)

  @@index([tenantId])
  @@map("ingredient_balances")
}

model StockMovement {
  id           String       @id @default(uuid()) @db.Uuid
  tenantId     String       @map("tenant_id") @db.Uuid
  ingredientId String       @map("ingredient_id") @db.Uuid
  type         MovementType
  quantity     Decimal      @db.Decimal(14, 3) // + entrada / − saída
  unitCost     Decimal?     @map("unit_cost") @db.Decimal(12, 4)
  occurredAt   DateTime     @default(now()) @map("occurred_at")
  saleId       String?      @map("sale_id") @db.Uuid
  isEstimated  Boolean      @default(false) @map("is_estimated")
  note         String?
  createdById  String?      @map("created_by_id") @db.Uuid
  createdAt    DateTime     @default(now()) @map("created_at")
  /// Estorno: esta movimentação anula a movimentação `reversesId` (lançamento digitado errado).
  reversesId   String?      @unique @map("reverses_id") @db.Uuid
  /// Quando esta movimentação foi estornada (nunca apagamos lançamentos do livro-razão).
  reversedAt   DateTime?    @map("reversed_at")

  tenant     Tenant         @relation(fields: [tenantId], references: [id], onDelete: Cascade)
  ingredient Ingredient     @relation(fields: [ingredientId], references: [id], onDelete: Restrict)
  sale       Sale?          @relation(fields: [saleId], references: [id], onDelete: Cascade)
  reverses   StockMovement? @relation("Reversal", fields: [reversesId], references: [id], onDelete: SetNull)
  reversedBy StockMovement? @relation("Reversal")

  @@index([tenantId, ingredientId, occurredAt])
  @@index([tenantId, occurredAt])
  @@index([saleId])
  @@map("stock_movements")
}

// ---------- Vendas ----------

model Sale {
  id            String         @id @default(uuid()) @db.Uuid
  tenantId      String         @map("tenant_id") @db.Uuid
  channel       SaleChannel
  soldAt        DateTime       @default(now()) @map("sold_at")
  totalAmount   Decimal        @map("total_amount") @db.Decimal(12, 2)
  totalWeightG  Decimal?       @map("total_weight_g") @db.Decimal(10, 1)
  notes         String?
  createdById   String?        @map("created_by_id") @db.Uuid
  createdAt     DateTime       @default(now()) @map("created_at")
  /// null = vendas registradas antes de existir o campo.
  paymentMethod PaymentMethod? @map("payment_method")
  status        SaleStatus     @default(COMPLETED)
  canceledAt    DateTime?      @map("canceled_at")
  canceledById  String?        @map("canceled_by_id") @db.Uuid
  cancelReason  String?        @map("cancel_reason")
  /// Correção: esta venda substitui a venda correctsId (que foi cancelada ao corrigir).
  correctsId    String?        @unique @map("corrects_id") @db.Uuid
  source        SaleSource     @default(APP)
  importId      String?        @map("import_id") @db.Uuid

  tenant      Tenant          @relation(fields: [tenantId], references: [id], onDelete: Cascade)
  items       SaleItem[]
  movements   StockMovement[]
  corrects    Sale?           @relation("SaleCorrection", fields: [correctsId], references: [id], onDelete: SetNull)
  correctedBy Sale?           @relation("SaleCorrection")
  import      SaleImport?     @relation(fields: [importId], references: [id], onDelete: SetNull)

  @@index([tenantId, soldAt])
  @@index([importId])
  @@index([tenantId, createdById, soldAt])
  @@map("sales")
}

model SaleItem {
  id        String   @id @default(uuid()) @db.Uuid
  tenantId  String   @map("tenant_id") @db.Uuid
  saleId    String   @map("sale_id") @db.Uuid
  productId String   @map("product_id") @db.Uuid
  quantity  Decimal  @db.Decimal(10, 3)
  unitPrice Decimal  @map("unit_price") @db.Decimal(12, 2)
  weightG   Decimal? @map("weight_g") @db.Decimal(10, 1)

  tenant      Tenant               @relation(fields: [tenantId], references: [id], onDelete: Cascade)
  sale        Sale                 @relation(fields: [saleId], references: [id], onDelete: Cascade)
  product     Product              @relation(fields: [productId], references: [id], onDelete: Restrict)
  ingredients SaleItemIngredient[]

  @@index([saleId])
  @@index([tenantId, productId])
  @@map("sale_items")
}

model SaleItemIngredient {
  id             String         @id @default(uuid()) @db.Uuid
  tenantId       String         @map("tenant_id") @db.Uuid
  saleItemId     String         @map("sale_item_id") @db.Uuid
  ingredientId   String         @map("ingredient_id") @db.Uuid
  quantity       Decimal?       @db.Decimal(14, 3)
  quantitySource QuantitySource @map("quantity_source")

  tenant     Tenant     @relation(fields: [tenantId], references: [id], onDelete: Cascade)
  saleItem   SaleItem   @relation(fields: [saleItemId], references: [id], onDelete: Cascade)
  ingredient Ingredient @relation(fields: [ingredientId], references: [id], onDelete: Restrict)

  @@index([saleItemId])
  @@map("sale_item_ingredients")
}

/// Lote de vendas históricas importadas (CSV). O hash do conteúdo impede importar o mesmo
/// arquivo duas vezes (enquanto o lote não for desfeito).
model SaleImport {
  id          String    @id @default(uuid()) @db.Uuid
  tenantId    String    @map("tenant_id") @db.Uuid
  fileName    String    @map("file_name")
  contentHash String    @map("content_hash")
  rows        Int
  firstDay    DateTime  @map("first_day") @db.Date
  lastDay     DateTime  @map("last_day") @db.Date
  totalAmount Decimal   @map("total_amount") @db.Decimal(14, 2)
  createdById String?   @map("created_by_id") @db.Uuid
  createdAt   DateTime  @default(now()) @map("created_at")
  undoneAt    DateTime? @map("undone_at")
  undoneById  String?   @map("undone_by_id") @db.Uuid

  tenant Tenant @relation(fields: [tenantId], references: [id], onDelete: Cascade)
  sales  Sale[]

  @@index([tenantId, createdAt])
  @@map("sale_imports")
}

// ---------- Auditoria ----------

model AuditLog {
  id        String   @id @default(uuid()) @db.Uuid
  tenantId  String   @map("tenant_id") @db.Uuid
  userId    String?  @map("user_id") @db.Uuid
  action    String
  entity    String
  entityId  String?  @map("entity_id")
  payload   Json?
  createdAt DateTime @default(now()) @map("created_at")

  tenant Tenant @relation(fields: [tenantId], references: [id], onDelete: Cascade)

  @@index([tenantId, createdAt])
  @@map("audit_logs")
}
