{
  "name": "gestock-backend",
  "version": "0.1.0",
  "private": true,
  "description": "API do Gestock - Node.js + TypeScript + Express (MVC + Service + Repository)",
  "main": "dist/server.js",
  "engines": {
    "node": ">=20"
  },
  "prisma": {
    "seed": "tsx prisma/seed.ts"
  },
  "scripts": {
    "dev": "tsx watch server.ts",
    "build": "tsc -p tsconfig.build.json && tsc-alias -p tsconfig.build.json",
    "start": "node dist/server.js",
    "start:render": "node prisma/preparar-banco.mjs && node dist/server.js",
    "lint": "eslint .",
    "typecheck": "tsc --noEmit",
    "format": "prettier --write \"**/*.ts\"",
    "test": "jest",
    "test:e2e": "jest --config test/jest-e2e.json --runInBand",
    "postinstall": "prisma generate",
    "prisma:generate": "prisma generate",
    "prisma:migrate": "prisma migrate dev",
    "prisma:deploy": "prisma migrate deploy",
    "prisma:studio": "prisma studio",
    "db:seed": "tsx prisma/seed.ts"
  },
  "jest": {
    "rootDir": ".",
    "testRegex": "test/unit/.*\\.spec\\.ts$",
    "moduleFileExtensions": [
      "ts",
      "js",
      "json"
    ],
    "moduleNameMapper": {
      "^@/(.*)$": "<rootDir>/$1"
    },
    "transform": {
      "^.+\\.ts$": "ts-jest"
    },
    "testEnvironment": "node"
  },
  "dependencies": {
    "@prisma/client": "6.16.2",
    "argon2": "0.44.0",
    "cookie-parser": "1.4.7",
    "cors": "2.8.5",
    "dotenv": "17.2.2",
    "express": "5.1.0",
    "express-rate-limit": "8.7.0",
    "helmet": "8.1.0",
    "jsonwebtoken": "9.0.2",
    "zod": "4.6.7"
  },
  "devDependencies": {
    "@types/cookie-parser": "1.4.9",
    "@types/cors": "2.8.19",
    "@types/express": "5.0.3",
    "@types/jest": "29.5.14",
    "@types/jsonwebtoken": "9.0.10",
    "@types/node": "20.19.11",
    "@types/supertest": "7.2.1",
    "eslint": "9.35.0",
    "jest": "29.7.0",
    "prettier": "3.6.2",
    "prisma": "6.16.2",
    "supertest": "7.3.2",
    "ts-jest": "29.4.1",
    "tsc-alias": "1.8.16",
    "tsx": "4.20.5",
    "typescript": "5.9.2",
    "typescript-eslint": "8.43.0"
  },
  "overrides": {
    "@prisma/config": {
      "effect": "3.20.0",
      "deepmerge-ts": "8.0.2"
    }
  }
}
