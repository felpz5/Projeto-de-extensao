# Variáveis do docker compose (copie para .env). Use só letras, números e hífen nas senhas:
# elas entram nas URLs de conexão do banco.

# Dono do banco (roda as migrations)
POSTGRES_PASSWORD=troque-senha-do-dono
# Usuário da API (gestock_app, sem BYPASSRLS)
APP_DB_PASSWORD=troque-senha-da-api

# Gere com: node -e "console.log(require('crypto').randomBytes(48).toString('base64url'))"
JWT_ACCESS_SECRET=troque-por-um-segredo-longo-e-aleatorio-de-48-bytes

# Portas no seu computador (opcional)
FRONTEND_PORT=8080
API_PORT=3333
DB_PORT=5432

# --- Produção (servidor) ---
# Endereço público do site, com https (ex.: https://gestock.seudominio.com.br)
# PUBLIC_URL=https://gestock.seudominio.com.br
# Quantos proxies ficam na frente da API: 1 = só o nginx do front; 2 = Caddy (HTTPS) + nginx
# TRUST_PROXY=2
