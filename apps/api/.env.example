# Ambiente: development | test | production
NODE_ENV=development
PORT=3333

# Banco (Supabase/Neon). DATABASE_URL = usuário da API (gestock_app, sem BYPASSRLS).
# DIRECT_URL = usuário dono das tabelas, usado só pelas migrations. Em dev podem ser iguais.
# Supabase com pooler (porta 6543): acrescente ?pgbouncer=true na DATABASE_URL.
DATABASE_URL=postgresql://gestock_app:senha@localhost:5432/gestock
DIRECT_URL=postgresql://postgres:senha@localhost:5432/gestock

# Gere com: node -e "console.log(require('crypto').randomBytes(48).toString('base64url'))"
JWT_ACCESS_SECRET=troque-por-um-segredo-longo-e-aleatorio
JWT_ACCESS_TTL=15m
REFRESH_TOKEN_TTL_DAYS=7

# Front-end autorizado (separe vários por vírgula)
CORS_ORIGIN=http://localhost:5173
# lax (mesmo domínio) | none (front e API em domínios diferentes, exige HTTPS)
COOKIE_SAMESITE=lax
